# SAP Agentic AI Demo - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# AWS Configuration (REQUIRED - Must be filled)
# ============================================================================
AWS_REGION=us-east-1                    # AWS region where resources will be deployed
AWS_ACCOUNT_ID=your-account-id-here     # Your 12-digit AWS account ID (REQUIRED)

# ============================================================================
# SAP System Configuration (REQUIRED - Must be filled)
# ============================================================================
SAP_BASE_URL=https://your-sap-system.com/sap/opu/odata/sap/API_SUPPLIERINVOICE_PROCESS_SRV  # SAP OData API endpoint (REQUIRED)
SAP_USERNAME=your-sap-username          # SAP system username (REQUIRED)
SAP_PASSWORD=your-sap-password          # SAP system password (REQUIRED)

# ============================================================================
# Project Configuration (Optional - Uses defaults if not changed)
# ============================================================================
PROJECT_NAME=sap-agentic-ai             # Prefix for AWS resource names (Optional)
ENVIRONMENT=dev                         # Environment suffix for resources (Optional)

# ============================================================================
# AWS Resource Names (Auto-generated - Do not change unless needed)
# ============================================================================
S3_BUCKET_NAME=sap-sops-${AWS_ACCOUNT_ID}      # S3 bucket for SOP documents (Auto-generated)
DYNAMODB_TABLE_NAME=invoice-state-${ENVIRONMENT}  # DynamoDB table name (Auto-generated)
SECRETS_SAP_NAME=sap_credentials                # Secrets Manager secret name for SAP (Auto-generated)
SECRETS_COGNITO_NAME=sap_cognito_config         # Secrets Manager secret name for Cognito (Auto-generated)

# ============================================================================
# Email Configuration (Optional - Leave empty to skip email features)
# ============================================================================
EMAIL_BUCKET_NAME=sap-email-${AWS_ACCOUNT_ID}  # S3 bucket for email storage (Auto-generated)
# Your verified domain in SES (e.g., example.com) - MUST be verified in SES console
SES_DOMAIN=your-domain.com                     # SES verified domain (Optional)
# Email address for agent notifications (must be verified in SES)
AGENT_EMAIL=agent@your-domain.com              # Agent notification email (Optional)

# ============================================================================
# Bedrock Configuration (Optional - Uses default model if not changed)
# ============================================================================
MODEL_ID=us.anthropic.claude-3-7-sonnet-20250219-v1:0  # Bedrock model ID (Optional)

# ============================================================================
# Cognito Configuration (REQUIRED - User Pool/Client auto-created if not exist)
# ============================================================================
COGNITO_USERNAME=your-username                    # Dashboard login username (REQUIRED - will be created)
COGNITO_TEMP_PASSWORD=your-secure-temp-password-here    # Temporary password for user creation (REQUIRED)
COGNITO_PERMANENT_PASSWORD=your-secure-permanent-password-here  # Actual login password (REQUIRED)

# ============================================================================
# Knowledge Base Configuration (Auto-populated - Leave empty for first deployment)
# ============================================================================
# FIRST TIME: Leave empty - system creates Knowledge Bases automatically
# SUBSEQUENT RUNS: System populates these IDs after first deployment for reuse
KNOWLEDGE_BASE_ID=                      # SOP Knowledge Base ID (Auto-populated)
DATA_SOURCE_ID=                         # SOP Data Source ID (Auto-populated)

# SAP API Knowledge Base Configuration (Auto-populated - Leave empty for first deployment)
SAP_API_KNOWLEDGE_BASE_ID=              # API Knowledge Base ID (Auto-populated)
SAP_API_DATA_SOURCE_ID=                 # API Data Source ID (Auto-populated)

# ============================================================================
# SOP Configuration (Optional - Uses directory if files not specified)
# ============================================================================
# SOP files to upload (comma-separated list, or leave empty to upload all PDFs from directory)
SOP_FILES=                              # Specific SOP files (Optional)
# Directory containing SOP files - system uploads all PDFs from this directory
SOP_DIRECTORY=sops/                     # SOP directory path (Optional - defaults to sops/)

# ============================================================================
# SAP API Documentation Configuration (Optional - Uses directory if files not specified)
# ============================================================================
# SAP API files to upload (comma-separated list, or leave empty to upload all files from directory)
SAP_API_FILES=                          # Specific API files (Optional)
# Directory containing SAP API documentation - system uploads all PDF/YAML files from this directory
SAP_API_DIRECTORY=sap-api-docs/         # API docs directory path (Optional - defaults to sap-api-docs/)
# S3 bucket for SAP API documentation
SAP_API_BUCKET_NAME=sap-api-docs-${AWS_ACCOUNT_ID}  # S3 bucket for API docs (Auto-generated)

# ============================================================================
# Lambda Configuration (Auto-generated - Do not change unless needed)
# ============================================================================
LAMBDA_ODATA_POLLER_NAME=invoice-odata-poller-${ENVIRONMENT}  # OData poller Lambda name (Auto-generated)
LAMBDA_EMAIL_PROCESSOR_NAME=s3-email-processor-${ENVIRONMENT}  # Email processor Lambda name (Auto-generated)

# ============================================================================
# Security Configuration (Optional - Uses AWS managed keys if not provided)
# ============================================================================
# KMS Key ID for encryption (optional - will use default AWS managed keys if not provided)
KMS_KEY_ID=                             # Custom KMS key ID (Optional)