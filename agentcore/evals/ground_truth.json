[
  {
    "test_id": "ap_price_variance_within_tolerance",
    "description": "Invoice unit price ~1% over PO price (within ±2% tolerance) should be matched and released without approval",
    "process_type": "price_variance",
    "payload": {
      "document_number": "5105600101",
      "item_id": "2026",
      "process_type": "price_variance"
    },
    "seed": {
      "sap_params": {
        "po_amount": 50000,
        "invoice_amount": 50500,
        "po_quantity": 10,
        "invoice_quantity": 10,
        "gr_quantity": 10,
        "payment_block": "R",
        "skip_gr": false
      }
    },
    "expected": {
      "outcome": "auto_release",
      "reason": "Price variance within ±2% tolerance per invoice-matching SOP",
      "required_tool_calls": [
        "get_case_state",
        "odata_read",
        "update_case_state"
      ]
    }
  },
  {
    "test_id": "ap_price_variance_above_tolerance",
