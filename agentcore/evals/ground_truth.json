    "process_type": "price_variance",
    "payload": {
      "document_number": "5105600102",
      "item_id": "2026",
      "process_type": "price_variance"
    },
    "seed": {
      "sap_params": {
        "po_amount": 50000,
        "invoice_amount": 54000,
        "po_quantity": 10,
        "invoice_quantity": 10,
        "gr_quantity": 10,
        "payment_block": "R",
        "skip_gr": false
      }
    },
    "expected": {
      "outcome": "approval_required",
      "reason": "Price variance exceeds ±2% tolerance — requires procurement approval per SOP",
      "required_tool_calls": [
        "get_case_state",
        "odata_read",
        "send_notification",
        "update_case_state"
      ]
    }
  },
