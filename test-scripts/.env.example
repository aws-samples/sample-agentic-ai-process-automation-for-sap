# Phase 1 Okta->SAP local smoke test (test-okta-sap-local.py).
# Copy to test-scripts/.env (git-ignored) and fill in your workspace's values.
#   cp test-scripts/.env.example test-scripts/.env
#   # edit test-scripts/.env, then:
#   set -a; . test-scripts/.env; set +a
#   uv run test-scripts/test-okta-sap-local.py

# ── Required. No defaults on purpose: a baked-in tenant or SAP host would
# silently test somebody else's system instead of yours.

# Use the issuer EXACTLY as the authorization server emits it — the script
# preflights this against the discovery doc and refuses to continue on mismatch.
#   custom AS (recommended): https://<org>.okta.com/oauth2/default
#   org AS:                  https://<org>.okta.com
OKTA_ISSUER=

# The Okta Web App client id (confidential app, client_secret_basic).
OKTA_CLIENT_ID=

# Its client secret. NEVER commit this.
OKTA_CLIENT_SECRET=

# Your SAP system's base URL, no trailing slash.
SAP_BASE_URL=

# ── Strongly recommended ─────────────────────────────────────────────────────

# SAP's own SOIDC client id. SAP rejects any token whose `aud` omits it, and
# Okta's default `api://default` will NOT match. Setting this turns a SAP-side
# 401 into a loud local failure that names the fix.
# OKTA_EXPECT_AUDIENCE=

# ── Optional overrides ───────────────────────────────────────────────────────
# OKTA_SCOPES=openid email
# SAP_CLIENT=100
# SAP_USERNAME / SAP_PASSWORD — only for the --basic differential probe.
